# Groq (LLM backfill for missing metadata fields)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Optional extraction tuning
# GROQ_MODEL=llama-3.1-8b-instant
# RULE_WORKERS=32
# LLM_WORKERS=1
# MIN_REQUEST_GAP=0.35

# PostgreSQL (used by database/db.py — also edit host/user there if needed)
# Default connection in code: dbname=maha_gr, user=<your OS user>, host=localhost

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
# NEO4J_BATCH_SIZE=500

# PostgreSQL
POSTGRES_DB=maha_gr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Embeddings (Phase 3)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32

# AI Reasoning (Phase 5) — keep prompts under Groq on-demand ~12k TPM limit
REASONING_MODEL=llama-3.3-70b-versatile
REASONING_MAX_FULL_TEXT_DOCS=8
CONFLICT_MAX_FULL_TEXT_DOCS=5
CONFLICT_TOP_K=10
GROQ_MAX_INPUT_TOKENS=9000
REASONING_CHARS_PER_TOKEN=2.2
CONFLICT_MAX_CONTEXT_CHARS=5500
CONFLICT_MAX_DRAFT_CHARS=2000
CONFLICT_EXCERPT_CHARS=700

# API Server Config
FRONTEND_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000

