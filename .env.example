# Local Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_CHAT_MODEL=llama3.1
REASONING_MODEL=llama3.1
INGEST_LLM_MODEL=llama3.1

# Optional extraction tuning
# RULE_WORKERS=32
# LLM_WORKERS=1
# MIN_REQUEST_GAP=0.35

# PostgreSQL (used by database/db.py — also edit host/user there if needed)
# Default connection in code: dbname=maha_gr, user=<your OS user>, host=localhost

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
# NEO4J_BATCH_SIZE=500

# PostgreSQL
POSTGRES_DB=maha_gr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Embeddings (Phase 3) — local_files_only=true allows conflict detection without WiFi
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_LOCAL_FILES_ONLY=true

# AI Reasoning (Phase 5) — tune to your Ollama model context window
REASONING_MAX_FULL_TEXT_DOCS=8
CONFLICT_MAX_FULL_TEXT_DOCS=3
CONFLICT_TOP_K=5
CONFLICT_MAX_TOKENS=768
LLM_MAX_INPUT_TOKENS=9000
REASONING_CHARS_PER_TOKEN=2.2
CONFLICT_MAX_CONTEXT_CHARS=3500
CONFLICT_MAX_DRAFT_CHARS=1500
CONFLICT_EXCERPT_CHARS=500
REASONING_MAX_RETRIES=1

# Glossary — deterministic scan is instant; set true only for deeper LLM review
GLOSSARY_USE_LLM=false

# Draft chat (isolated Ollama client)
# CHAT_MAX_TOKENS=400
# CHAT_MAX_DRAFT_CHARS=8000
# CHAT_MAX_HISTORY=12
# CHAT_TEMPERATURE=0.2

# API Server Config
FRONTEND_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
